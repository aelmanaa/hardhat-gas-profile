{
  "name": "hardhat-gas-profile",
  "version": "0.0.0",
  "description": "Hardhat 3 plugin that profiles the gas of Solidity tests: a per-test summary, folded stacks for flamegraph tools, and an HTML report.",
  "keywords": [
    "hardhat-plugin",
    "hardhat",
    "hardhat3",
    "solidity",
    "gas",
    "profiler",
    "flamegraph",
    "edr"
  ],
  "license": "MIT",
  "author": {
    "name": "Amine El Manaa",
    "url": "https://github.com/aelmanaa"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aelmanaa/hardhat-gas-profile.git"
  },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "build": "tsc --build .",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p . && tsc -p scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "test": "node --import tsx/esm --test --test-reporter=spec \"test/*.ts\"",
    "test:scripts": "node --test \"scripts/test/*.test.ts\"",
    "pkg:check": "pnpm run build && publint --strict && attw --pack . --profile esm-only",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only --ignore-scripts",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@nomicfoundation/edr": "^0.25.0",
    "@nomicfoundation/hardhat-errors": "^3.1.3",
    "@nomicfoundation/hardhat-utils": "^5.1.1"
  },
  "peerDependencies": {
    "hardhat": "^3.21.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "^22.10.0",
    "hardhat": "link:../hardhat-wt-include-traces/packages/hardhat",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "publint": "0.3.25",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
