{
  "name": "hardhat-gas-profile",
  "version": "0.1.0",
  "description": "Hardhat 3 plugin that profiles the gas of Solidity tests: a per-test summary, folded stacks for flamegraph tools, and an HTML report.",
  "keywords": ["hardhat-plugin", "hardhat", "hardhat3", "solidity", "gas", "profiler", "flamegraph", "edr"],
  "license": "MIT",
  "author": { "name": "Amine El Manaa", "url": "https://github.com/aelmanaa" },
  "repository": { "type": "git", "url": "git+https://github.com/aelmanaa/hardhat-gas-profile.git" },
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" }
  },
  "files": ["dist/src/", "src/", "README.md", "LICENSE"],
  "engines": { "node": ">=22.10.0" },
  "scripts": {
    "build": "tsc --build .",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --import tsx/esm --test --test-reporter=spec \"test/*.ts\"",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "dependencies": {
    "@nomicfoundation/edr": "^0.25.0",
    "@nomicfoundation/hardhat-errors": "^3.1.3",
    "@nomicfoundation/hardhat-utils": "^5.1.1"
  },
  "peerDependencies": {
    "hardhat": "^3.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "hardhat": "link:../hardhat-wt-include-traces/packages/hardhat",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  }
}
