{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "import", "node", "promise", "oxc", "unicorn"],
  "options": {
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "test/fixture-projects/**/artifacts/**",
    "test/fixture-projects/**/cache/**",
    "node_modules/**"
  ]
}
