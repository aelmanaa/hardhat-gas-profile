{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"]
  },
  "include": ["src", "test"],
  "exclude": [
    "dist",
    "node_modules",
    "test/fixture-projects/**/artifacts",
    "test/fixture-projects/**/cache"
  ]
}
